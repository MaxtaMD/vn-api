# Comma-separated list of origins allowed to call /api/stream/*.
# /proxy is NOT gated by this — it's protected by the encrypted token instead.
# Leave unset to run open (dev mode, all origins allowed).
# Example: ALLOWED_ORIGINS=https://clixarena.com,https://www.clixarena.com
ALLOWED_ORIGINS=

# Secret used to derive the AES-256-GCM key for /proxy tokens (see api/proxy_token.py).
# Always set a real value in production — the fallback dev secret is public/insecure.
PROXY_SIGNING_SECRET=

# Optional: how long a proxy token stays valid, in seconds (default 21600 = 6h).
PROXY_TOKEN_TTL_SECONDS=21600

# /proxy's inbuilt cache + prefetch (ports universal-proxy's behavior in —
# see api/index.py). Defaults match universal-proxy's own.
MAX_CACHE_BYTES=157286400
SEGMENT_CACHE_TTL=21600
MANIFEST_CACHE_TTL=300
ENABLE_PREFETCH=true
PREFETCH_COUNT=64
PREFETCH_CONCURRENCY=8
